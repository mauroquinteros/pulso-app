{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
  // Edge Functions run on Deno, not on Hermes: they use the `Deno` global and
  // `npm:` specifiers, neither of which this config knows. Checking them here
  // produced 13 permanent errors that made `tsc --noEmit` useless as a signal.
  // They are checked by `deno check`, not by the app's compiler.
  "exclude": ["supabase/functions"]
}
