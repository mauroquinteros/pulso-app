# Copy to .env and fill in. The .env file is gitignored.
#
# Both values come from the Supabase dashboard: Project Settings > API Keys.
# Use the publishable key (sb_publishable_...), never the secret key -- the
# secret key bypasses RLS. The publishable key is not a secret: it ships inside
# the binary and its safety rests entirely on RLS.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-url.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here
